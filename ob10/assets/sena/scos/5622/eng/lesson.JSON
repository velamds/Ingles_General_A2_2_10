{"_data": [{"contents": [{"content": "Peter Prepares for Final Exams", "type": "lesson_name"}, {"content": "Finally Over", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe characteristics of different people and their jobs", "type": "primary"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_3"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_4"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le10ob10re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "The First Conditional", "type": "heading"}, {"content": "You can use the First Conditional to talk about actions and situations in the future.", "type": "describer"}, {"content": "There are two parts to the sentence.  ", "type": "text"}, {"content": " One part is the <span class=\"strong\">condition</span>. The other part is the <span class=\"strong\">result</span>.", "type": "text"}, {"content": "Form: <br><span class=\"italic\">If + subject + Simple Present tense  + subject + will or can </span><br> You use a comma after the condition in this form.  ", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Condition \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Result\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> If I graduate in accounting,  </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'll be able work in many departments. </span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": " You can change the two parts of the sentence so that the result comes first.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Result \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Condition\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'll take Advanced Accounting Methods next term</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">if I get a good grade this course.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "&nbsp;", "type": "text"}], "type": "learning_points"}, {"contents": [{"content": "Modals May, Might, Will", "type": "heading"}, {"content": "You use the modals <span class=\"italic\">may</span> and <span class=\"italic\">might</span> to show possibility. They have the same meaning. <br>  You use the modal <span class=\"italic\">will</span> to predict the future in a more certain way.", "type": "describer"}, {"content": "Modals go before a verb in the base form. The verb does not change.", "type": "text"}, {"content": "{\"rows\":1,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I think accounting may be a very interesting career.<br> I might do well on the exam.<br> I'll take either Techniques of Leadership or IT Systems next year.</span>\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "method ", "type": "name"}, {"content": "way; manner ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'll take the course Advanced Accounting Methods next term.", "type": "example"}, {"content": "engenn5le10ob10aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use to talk about programs of study.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "technique ", "type": "name"}, {"content": "way; manner; method ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  I'll take the course Techniques of Leadership next year.", "type": "example"}, {"content": "engenn5le10ob10aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "leadership ", "type": "name"}, {"content": "the ability to lead and inspire people ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The course Techniques of Leadership is very interesting.", "type": "example"}, {"content": "engenn5le10ob10aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "IT ", "type": "name"}, {"content": "Information Technology (computers) ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Maybe I will take the course IT Systems.", "type": "example"}, {"content": "engenn5le10ob10aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to graduate", "type": "name"}, {"content": "to finish studying in a program", "type": "definition"}, {"content": " (verb)", "type": "part_speech"}, {"content": " Example: When you graduate in accounting, you can work in many departments. ", "type": "example"}, {"content": "engenn5le10ob10aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "advanced", "type": "name"}, {"content": "at a high level ", "type": "definition"}, {"content": " (adjective)", "type": "part_speech"}, {"content": "Example: Did you take the course Advanced Accounting?", "type": "example"}, {"content": "engenn5le10ob10aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Think of six actions or events that could take place in your life in the future.", "type": "text"}, {"content": "Decide if each thing is possible or certain.", "type": "text"}, {"content": "Talk about each thing. If it is possible, use <span class=\"italic\">may</span> or <span class=\"italic\">might</span>. If it is more certain, use <span class=\"italic\">will</span>.", "type": "text"}, {"content": "Ask your partner to talk about actions or events in their future.", "type": "text"}, {"content": "Discuss the actions or events.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I think of future actions or events.", "type": "text"}, {"content": "I talk about future actions or events.", "type": "text"}, {"content": "I listen to my partner.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le10ob10re2img01.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le10ob10re2img01.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Sonia</span>: How was the final exam, Peter?<br>\n<span class=\"strong\">Peter</span>: It was OK. I only missed one page. I hope there weren't too many questions on it. What about you?<br>\n<span class=\"strong\">Sonia</span>: It went well. I might do well on the exam. I'll take Advanced Accounting Methods next term if I get a good grade this course.<br>\n<span class=\"strong\">Peter</span>: I know you will get a good grade."}, {"image": "engenn5le10ob10re2img01.jpg", "time": "19500", "id": 2, "text": "<span class=\"strong\">Sonia</span>: I think accounting may be a very interesting career. If I graduate in accounting, I'll be able to work in many departments. My cousin is an accountant, and now she has a great job.   <br>\n<span class=\"strong\">Peter</span>: A career in accounting? Yuck! <br>\n<span class=\"strong\">Sonia</span>: I'll take either Techniques of Leadership or IT Systems next year."}, {"image": "engenn5le10ob10re2img06.jpg", "time": "39000", "id": 3, "text": "<span class=\"strong\">Peter</span>: Those are two very different courses.<br>\n<span class=\"strong\">Sonia</span>:  I know! It's hard to decide.<br>\n<span class=\"strong\">Peter</span>: Just two more summer courses and then it's finally over for me! Yahoo!"}], "audiosrc": "engenn5le10ob10re2aud01", "coverimg": "engenn5le10ob10re2img01.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about subjects to study.", "type": "Learning Outcomes"}, {"content": "  I can talk about hypothetical actions and events in the fu