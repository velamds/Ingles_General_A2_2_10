"id": 0, "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "contents": [{}], "id": 0}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le10ob07re2aud01", "coverimg": "engenn5le10ob07re2img06.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le10ob07re2img06.jpg"}, {"text": "<span class=\"strong\">Peter</span>: Thanks for inviting me to this cottage, guys! I really needed a break from school. <br>\n<span class=\"strong\">Nancy</span>: I'm glad you came with us, Peter. You always make me laugh.<br>\n<span class=\"strong\">Peter</span>: I'm not quite sure how I do that.<br>\n<span class=\"strong\">Nancy</span>: Ah-hah!  You see? You're so funny.<br>", "id": 1, "time": "100", "image": "engenn5le10ob07re2img06.jpg"}, {"text": "<span class=\"strong\">Nigel</span>: What do you do on your free time, Peter?<br>\n<span class=\"strong\">Peter</span>: I go to the gym and I cycle everywhere. I enjoy going to the movies. What about you?<br>\n<span class=\"strong\">Nigel</span>: I go bungee jumping and ziplining.<br>\n<span class=\"strong\">Peter</span>:  Ziplining? That's so cool!  Can I come?<br>\n<span class=\"strong\">Nancy</span>:  Ah-hah!  You're so funny, Peter!<br>\n<span class=\"strong\">Peter</span>: I'm serious! <br>", "id": 2, "time": "14000", "image": "engenn5le10ob07re2img01.jpg"}, {"text": "<span class=\"strong\">Nigel</span>:  Sure. I promise we'll come back to the cottage. We'll go next time we have a school break. We'll go ziplining then. <br>\n<span class=\"strong\">Peter</span>: Great, I can't wait! <br>\n<span class=\"strong\">Nancy</span>:  Ah-hah!  You're so funny, Peter!<br>\n<span class=\"strong\">Peter</span>: What should I wear?<br>\n<span class=\"strong\">Nigel</span>:  I suggest you wear a light jacket and hiking boots.  <br>\n<span class=\"strong\">Peter</span>: Cool!<br>", "id": 3, "time": "33000", "image": "engenn5le10ob07re2img01.jpg"}]}}]}, {"id": 2, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "picture", "value": {"audiosrc": "engenn5le10ob07re5aud01", "coverimg": "engenn5le10ob07re5img01.jpg", "images": []}}]}]}], "type": "sena"}